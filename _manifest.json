{
  "manifest_version": 2,
  "version": "1.7.1",
  "name": "OAImage",
  "description": "使用 OpenAI GPT Image 2.6 生成静态图片、文生 GIF 和参考图动图。支持命令与自然语言。NovelAI V5 Full 提供独立文生图。",
  "author": {
    "name": "A-Dawn",
    "url": "https://github.com/A-Dawn"
  },
  "license": "Apache-2.0",
  "urls": {
    "repository": "https://github.com/krkr521/OAImage",
    "homepage": "https://github.com/A-Dawn/OAImage",
    "documentation": "https://github.com/A-Dawn/OAImage/blob/1.0.x/README.md",
    "issues": "https://github.com/A-Dawn/OAImage/issues"
  },
  "host_application": {
    "min_version": "1.3.18",
    "max_version": "1.99.99"
  },
  "sdk": {
    "min_version": "2.19.0",
    "max_version": "2.99.99"
  },
  "dependencies": [
    {
      "type": "python_package",
      "name": "aiohttp",
      "version_spec": ">=3.8.0"
    }
  ],
  "capabilities": [
    "send.image",
    "send.text",
    "message.get_recent",
    "message.build_readable",
    "maisaka.proactive.trigger",
    "llm.generate",
    "database.save",
    "message.get_by_id",
    "maisaka.context.resolve_image",
    "maisaka.context.append"
  ],
  "i18n": {
    "default_locale": "zh-CN",
    "locales_path": "_locales",
    "supported_locales": [
      "zh-CN"
    ]
  },
  "id": "a-dawn.oaimage"
}
